# ── Banco de Dados (Neon Postgres) ───────────────────────────────────────────
# Connection string do Neon com HTTP pooler habilitado.
# Formato: postgresql://<user>:<password>@<host>/<dbname>?sslmode=require
DATABASE_URL=postgresql://usuario:senha@host.neon.tech/jurisradar?sslmode=require

# ── Autenticação (NextAuth.js v5) ─────────────────────────────────────────────
# Segredo para assinar tokens JWT. Gere com: openssl rand -base64 32
NEXTAUTH_SECRET=seu-segredo-aqui
NEXTAUTH_URL=http://localhost:3000

# ── Inngest (Job Processing) ──────────────────────────────────────────────────
# Chave de evento e signing key do Inngest para processamento de jobs.
INNGEST_EVENT_KEY=seu-event-key-aqui
INNGEST_SIGNING_KEY=seu-signing-key-aqui

# ── DataJud API (Consulta de Processos) ───────────────────────────────────────
# Chave de acesso à API pública do DataJud (CNJ).
DATAJUD_API_KEY=sua-api-key-aqui

# Número de tribunais processados por lote/invocação do Inngest (padrão: 10).
DATAJUD_BATCH_SIZE=10
